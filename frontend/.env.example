# Copy this file to .env and fill in your own values. .env is gitignored;
# this example file is NOT.

# GraphQL backend — proxied through the Vite dev server at /api/graphql so the
# browser never speaks to upstream directly. The proxy target + API key are
# server-only.
VITE_GRAPHQL_ENDPOINT=/api/graphql
VITE_GRAPHQL_PROXY_TARGET=https://api.example.com/v2/graphql
VITE_API_KEY=your_api_key_here
VITE_ORDER_EDITOR_API_KEY=your_order_editor_api_key_here

# Catalog defaults
VITE_BASE_CATEGORY_ID=1
# Channel orders/quotes are placed on. Account order/quote lists filter by it,
# so a wrong value returns zero results. Match your Propeller environment.
VITE_CHANNEL_ID=1
VITE_MENU_DEPTH=3
# No longer used. The anonymous user id is now derived server-side from the
# channel — channel(channelId).anonymousUserId, keyed by VITE_CHANNEL_ID above.
VITE_ANONYMOUS_USER_ID=0

# ── Machines / spare parts ──────────────────────────────────────────────────
# External system the machine ("installation") ids belong to, paired with each
# id as machine(source:, sourceId:). The id list is read at runtime from the
# contact's company MY_INSTALLATIONS track attribute (already in
# configuration.companyTrackAttributes). Leave unset to disable the machines
# root. Tree language is usually EN while parts stay in the storefront language.
VITE_BOILERPLATE_MACHINE_SOURCE=
VITE_BOILERPLATE_MACHINE_LANGUAGE=EN

# Localisation
VITE_DEFAULT_LANGUAGE=NL
VITE_URL_PATTERN=page/id/slug
VITE_TIMEOUT=30000

# Catalog visibility mode — kebab-case: 'open' | 'semi-closed' | 'closed'.
# 'semi-closed' hides prices for anonymous users and omits the `offers` block
# from JSON-LD output. Defaults to 'open' if unset.
VITE_PORTAL_MODE=open

# Absolute origin of this site (no trailing slash). Used to build absolute URLs
# in schema.org / JSON-LD payloads emitted by ProductJsonLd / ClusterJsonLd /
# ItemListJsonLd. When unset the JSON-LD emits path-only URLs.
VITE_SITE_URL=https://shop.example.com

# Server-side SSR data fetching (read by server.js / src/lib/server.ts via
# process.env). Vite statically strips process.env.VITE_* in the SSR transform,
# so the seam needs its own vars.
SSR_GRAPHQL_ENDPOINT=https://api.example.com/v2/graphql
SSR_API_KEY=your_api_key_here
SSR_ORDER_EDITOR_API_KEY=your_order_editor_api_key_here

# Shared secret gating POST /api/revalidate. Unset = endpoint returns 503
# (fails closed).
REVALIDATE_SECRET=replace_with_a_long_random_string

# ── Payments (Mollie / MultiSafepay PSP) ────────────────────────────────────
# Active payment provider — 'mollie' or 'multisafepay'. Turns on the hosted
# checkout flow (place order → PSP hosted checkout → three-state thank-you).
# Anything else keeps the previous "place order → straight to thank-you"
# behaviour. Only ONE PSP is active at a time.
PAYMENT_PROVIDER=mollie
# Client mirror — read by the checkout view via import.meta.env. Keep in sync
# with PAYMENT_PROVIDER (same value).
VITE_PAYMENT_PROVIDER=mollie

# Mollie API keys. SERVER-ONLY (no VITE_ prefix → never bundled into the
# browser). Get these from the Mollie Dashboard (Developers → API keys).
MOLLIE_LIVE_KEY=live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MOLLIE_TEST_KEY=test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# true → use the test key, false → use the live key. Defaults to true.
MOLLIE_TEST_MODE=true

# MultiSafepay API keys. SERVER-ONLY. Set PAYMENT_PROVIDER=multisafepay (and the
# VITE_ mirror) to use these instead of Mollie. MSP_TEST_MODE=true →
# testapi.multisafepay.com + MSP_TEST_KEY; false → api.multisafepay.com +
# MSP_LIVE_KEY. Get the site API key(s) from the MultiSafepay dashboard.
MSP_LIVE_KEY=your_live_site_api_key
MSP_TEST_KEY=your_test_site_api_key
MSP_TEST_MODE=true

# Methods that settle ON ACCOUNT and do NOT go through a PSP. Comma-separated,
# case-insensitive. For these the order is placed straight to NEW; every other
# method goes through the active PSP. Defaults to "REKENING,ON_ACCOUNT" when unset.
ON_ACCOUNT_PAYMENTS=REKENING,ON_ACCOUNT
# Client mirror — keep in sync with ON_ACCOUNT_PAYMENTS.
VITE_ON_ACCOUNT_PAYMENTS=REKENING,ON_ACCOUNT

# ISO 4217 currency CODE sent to the PSP (e.g. EUR/USD/GBP) — the 3-letter code,
# NOT a display symbol. Defaults to EUR.
VITE_CURRENCY_CODE=EUR

# The PSP POSTs its webhook/notification to VITE_SITE_URL + the route path
# (Mollie: /api/mollie/webhook, form body `id`; MSP: /api/msp/webhook?transactionid=),
# which must be PUBLICLY reachable over HTTPS — a PSP cannot reach localhost or
# LAN IPs. In dev, expose the server with a tunnel (cloudflared / ngrok) and
# either point VITE_SITE_URL at the tunnel or set the matching override below.
# Each accepts a bare origin (we append the route path) or the full webhook URL.
# MOLLIE_WEBHOOK_URL=https://your-tunnel.trycloudflare.com
# MSP_WEBHOOK_URL=https://your-tunnel.trycloudflare.com

# ── CMS (Strapi / Prepr) ────────────────────────────────────────────────────
# Selects the CMS adapter for pages + blog. One of: none | strapi | prepr.
# `none` disables the CMS (catch-all CMS routes 404; blog shows the fallback).
# Read server-side by the CMS provider (src/lib/cms).
CMS_PROVIDER=none

# Strapi (only used when CMS_PROVIDER=strapi)
# STRAPI_API_URL=http://localhost:1337
# STRAPI_API_TOKEN=

# Prepr (only used when CMS_PROVIDER=prepr) — Prepr puts the access token in the
# GraphQL URL, so there is no separate CMS URL. (Preview / tracking vars are
# added with the Prepr runtime layer.)
# PREPR_ACCESS_TOKEN=your-prepr-graphql-token

# Prepr client mirror (REQUIRED for Prepr) — turns on client-side Prepr wiring
# (tracking pixel, personalization, preview bar). Keep in sync with CMS_PROVIDER.
# VITE_CMS_PROVIDER=prepr
#
# Prepr data-collection tracking pixel token (Settings → Data collection) — NOT
# the GraphQL access token. Public; manages the __prepr_uid visitor cookie.
# VITE_PREPR_TRACKING_TOKEN=your-prepr-tracking-token
#
# Preview (draft content). PREPR_PREVIEW_TOKEN is a server-only Preview-scoped
# Delivery token; PREPR_PREVIEW_SECRET guards /api/preview (configure Prepr's
# preview URL as https://<host>/api/preview?secret=<PREPR_PREVIEW_SECRET>&slug=/{slug}&locale={locale}).
# PREPR_PREVIEW_TOKEN=your-prepr-preview-token
# PREPR_PREVIEW_SECRET=prepr-preview
#
# Publish webhook → cache revalidation: point a Prepr publish webhook at
# POST /api/cms-revalidate with header X-Revalidate-Secret: <REVALIDATE_SECRET>.

# ── Behaviour tracking ───────────────────────────────────────────
# Optional. With nothing configured the shop runs normally, /api/track answers
# 202 and /tracker says so instead of showing empty charts.
#
# Nothing is created automatically — not at install, not at first boot: DDL at
# boot races across instances and needs privileges the app account usually does
# not have. Run `npm run tracking:init` once the variables below point at a
# database (add `-- --dry-run` to see what it would do, `-- --print-sql` to get
# a file a DBA can run by hand).
#
# SERVER-ONLY. These must never get a VITE_ prefix — Vite inlines every VITE_*
# variable into the browser bundle, which would publish the credentials.
#
# THREE WAYS TO CONNECT — pick one.
#
# 1. A single URL. Wins over everything below when set, and is how a hosting
#    platform normally injects a database.
# TRACKING_DB_URL=mysql://user:password@db.internal:3306/propeller_analytics
#
# 2. A unix socket, for a database on the same Linux host. Beats host/port when
#    set, and is the only way in for an account that uses auth_socket.
# TRACKING_DB_SOCKET=/var/run/mysqld/mysqld.sock
# TRACKING_DB_NAME=propeller_analytics
#
# 3. Host and port. TRACKING_DB_PORT defaults to 3306; Laragon's second MySQL 8
#    instance runs on 3307, which is why the dev value below is not the default.
# TRACKING_ENABLED=true
# TRACKING_DB_HOST=127.0.0.1
# TRACKING_DB_PORT=3307
# TRACKING_DB_USER=root
# TRACKING_DB_PASSWORD=
# TRACKING_DB_NAME=propeller_analytics
# TRACKING_DB_POOL=4
#
# TLS. Every managed MySQL (RDS, Aiven, PlanetScale, DigitalOcean) refuses
# plaintext, so this is required off-host. `true` verifies against the system CA
# store; `skip-verify` encrypts without authenticating the server (a tunnel, not
# security); any other value names a built-in mysql2 profile, e.g. "Amazon RDS".
# TRACKING_DB_SSL=true
# IANA zone used to bucket the daily rollups. Days are bucketed in Node, not via
# MySQL CONVERT_TZ, whose timezone tables are frequently unloaded and which then
# returns NULL rather than erroring — silently dropping rollup rows.
TRACKING_TIMEZONE=Europe/Amsterdam
TRACKING_RETENTION_DAYS=180

# Client-visible master switch. Build-time: a false build dead-code-eliminates
# the whole subscriber rather than shipping it dormant.
VITE_TRACKING_ENABLED=false

# ── Google Analytics 4 / Tag Manager ───────────────────────────────────────
# A second subscriber on the same event bus: the storefront emits its own
# vocabulary and src/lib/tracking/ga4.ts projects it onto Google's. Off by
# default — with VITE_USE_GA4=false nothing is loaded and no dataLayer exists.
#
# VITE_GA4_KEY is required when VITE_USE_GA4=true; with no key nothing loads.
# VITE_GTM_KEY is optional, and it CHANGES THE TRANSPORT: with a container we
# push {event, ecommerce} objects to dataLayer, without one we call
# gtag('event'). The two are not interchangeable — the wrong one fails silently.
VITE_USE_GA4=false
VITE_GA4_KEY=
VITE_GTM_KEY=

# --- End-to-end test accounts -------------------------------------------------
#
# Only needed to run `npm run test:e2e`. The Playwright fixtures read these and
# THROW when they are missing - deliberately, with no fallback: this repo is
# mirrored to a public GitHub repo and is the source for scaffolded shops, so a
# hardcoded account would be a real login published to everyone.
TEST_CONTACT_USERNAME=
TEST_CONTACT_PASSWORD=
TEST_CUSTOMER_USERNAME=
TEST_CUSTOMER_PASSWORD=
